// Deploy-time configuration. Identical to wrangler.jsonc plus the Artifacts
// binding, which (open beta) only supports the remote service — local dev and
// tests use wrangler.jsonc so they run without a Cloudflare account.
//
// One-time account setup (see README):
//   npx wrangler artifacts namespaces create latch
//   npx wrangler queues create latch-artifacts-events
//   npx wrangler queues subscription create latch-artifacts-events \
//     --source artifacts --events cf.artifacts.repo.pushed
//   npx wrangler deploy -c wrangler.deploy.jsonc
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "latch",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-08-15",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "AI_GATEWAY_ACCOUNT_ID": "<YOUR_ACCOUNT_ID>",
    "AI_GATEWAY_ID": "default",
    "MODEL": "claude-sonnet-5",
    "GITHUB_CLIENT_ID": "<YOUR_GITHUB_OAUTH_CLIENT_ID>"
  },
  // AUTH_SECRET turns on GitHub session auth (fail-closed: without it the
  // deployment would run in dev-identity mode). GITHUB_CLIENT_SECRET signs
  // the OAuth code exchange.
  "secrets": {
    "required": ["AI_GATEWAY_TOKEN", "AUTH_SECRET", "GITHUB_CLIENT_SECRET"]
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "artifacts": [
    {
      "binding": "ARTIFACTS",
      "namespace": "latch",
      // Always remote in local dev too; deploying is the only supported path.
      "remote": true
    }
  ],
  "queues": {
    "consumers": [
      {
        "queue": "latch-artifacts-events",
        "max_batch_size": 1,
        "max_retries": 3
      }
    ]
  },
  "containers": [
    {
      "class_name": "AgentSandbox",
      "scheduling_policy": "durable_object",
      "images": {
        "agent": {
          "dockerfile": "./container/Agent.Dockerfile"
        }
      }
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "COORDINATOR",
        "class_name": "Coordinator"
      },
      {
        "name": "AGENT_SANDBOX",
        "class_name": "AgentSandbox"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["Coordinator"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["AgentSandbox"]
    }
  ],
  "observability": {
    "enabled": true
  }
}
